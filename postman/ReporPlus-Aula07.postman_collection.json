    {
      "name": "01 - Cadastrar categoria",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const runId = Date.now().toString();",
              "const baseCnpj = ('000000000000' + runId).slice(-12);",
              "const calcularDigito = (numeros) => {",
              "  let peso = numeros.length - 7;",
              "  let soma = 0;",
              "  for (const numero of numeros) {",
              "    soma += Number(numero) * peso--;",
              "    if (peso < 2) peso = 9;",
              "  }",
              "  const resto = soma % 11;",
              "  return resto < 2 ? 0 : 11 - resto;",
              "};",
              "const primeiroDigito = calcularDigito(baseCnpj);",
              "const cnpj = baseCnpj + primeiroDigito + calcularDigito(baseCnpj + primeiroDigito);",
              "pm.collectionVariables.set('categoriaNome', `Filtros Aula 07 ${runId}`);",
              "pm.collectionVariables.set('cnpj', cnpj);",
              "pm.collectionVariables.set('pecaCodigo', `AULA07-${runId}`);",
              "pm.collectionVariables.unset('categoriaId');",
              "pm.collectionVariables.unset('fornecedorId');",
              "pm.collectionVariables.unset('pecaId');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Categoria criada', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.collectionVariables.set('categoriaId', pm.response.json().id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{categoriaNome}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/categorias-pecas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categorias-pecas"
          ]
        }
