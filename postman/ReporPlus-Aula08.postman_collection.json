    {
      "name": "01 - Cadastrar categoria",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "const baseCnpj = ('000000000000' + runId).slice(-12);",
              "const digito = (numeros) => { let peso = numeros.length - 7, soma = 0; for (const n of numeros) { soma += Number(n) * peso--; if (peso < 2) peso = 9; } const resto = soma % 11; return resto < 2 ? 0 : 11 - resto; };",
              "const d1 = digito(baseCnpj);",
              "pm.collectionVariables.set(\"categoriaNome\", `Filtros Aula 08 ${runId}`);",
              "pm.collectionVariables.set(\"categoriaNomeAtualizada\", `Filtros e Lubrificacao ${runId}`);",
              "pm.collectionVariables.set(\"cnpj\", baseCnpj + d1 + digito(baseCnpj + d1));",
              "pm.collectionVariables.set(\"pecaCodigo\", `AULA08-${runId}`);",
              "[\"categoriaId\", \"fornecedorId\", \"pecaId\"].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Categoria criada\", () => { pm.response.to.have.status(201); pm.collectionVariables.set(\"categoriaId\", pm.response.json().id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categorias-pecas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{categoriaNome}}\"\n}"
        }
      },
      "response": []
    },
